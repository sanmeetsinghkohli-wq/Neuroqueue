# NeuroQueue backend environment. Copy to .env and fill in. NEVER commit .env.
NQ_MOCK_MODE=false
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Supabase project "brain2" (leave empty to use the local JSON store) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Either the service-role key, or the dedicated service account created by supabase/schema.sql:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_EMAIL=
SUPABASE_SERVICE_PASSWORD=

# --- Alibaba Cloud Model Studio (Qwen). Hackathon key: server-side only ---
DASHSCOPE_API_KEY=change-me
DASHSCOPE_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen3.8-flash
QWEN_REPORT_MODEL=qwen3.8-max

# --- AssemblyAI (voice agent speech-to-text) ---
ASSEMBLYAI_API_KEY=change-me

# --- First administrator (created on first start) and demo accounts (`seed`) ---
ADMIN_EMAIL=admin@neuroqueue.test
ADMIN_PASSWORD=change-me
ADMIN_INVITE_CODE=change-me
DEMO_DOCTOR_EMAIL=doctor@neuroqueue.test
DEMO_DOCTOR_PASSWORD=change-me
DEMO_PATIENT_EMAIL=patient@neuroqueue.test
DEMO_PATIENT_PASSWORD=change-me

SUPPORT_EMAIL=2200031362csehh@gmail.com
SUPPORT_PHONE=+971 528813637

# --- Sessions and site URL ---
APP_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# true when the site forwards /api to this server (Vercel, any reverse proxy): use the forwarded client address for rate limits
TRUST_PROXY=false

# --- Outgoing email for verification and password reset. Leave empty to use the development outbox (admin > Users) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Google sign-in (OAuth client ID of type "Web application"; the ID is public, there is no secret to store) ---
GOOGLE_CLIENT_ID=

# Only for hosts that block outgoing SMTP (e.g. Railway): send through the site instead. Same secret on both sides.
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=
